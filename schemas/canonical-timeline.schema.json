{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexora-vpe.local/schemas/canonical-timeline.schema.json",
  "title": "Nexora VPE Canonical Timeline Artifact",
  "description": "Structured canonical replay timeline for formative debrief. It uses simulation_time_s only and contains no generated narration, score, pass/fail result, or clinical recommendation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scenario_id", "time_axis", "entries"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "scenario_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
    "time_axis": {"type": "string", "const": "simulation_time_s"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "branch_id", "simulation_time_s", "event", "snapshot", "branch_boundary"],
        "properties": {
          "sequence": {"type": "integer", "minimum": 1},
          "branch_id": {"type": "integer", "minimum": 0},
          "simulation_time_s": {"type": "number", "minimum": 0},
          "event": {"$ref": "event-envelope.schema.json"},
          "snapshot": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["snapshot_id", "scenario_id", "simulation_time_s", "engine_version", "telemetry", "reason"],
                "properties": {
                  "snapshot_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
                  "scenario_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
                  "simulation_time_s": {"type": "number", "minimum": 0},
                  "engine_version": {"type": "string", "minLength": 1},
                  "telemetry": {"type": "object", "additionalProperties": {"type": "number"}},
                  "reason": {"type": "string", "minLength": 1}
                }
              }
            ]
          },
          "branch_boundary": {"type": "boolean"}
        }
      }
    }
  }
}

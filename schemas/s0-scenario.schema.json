{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexora-vpe.local/schemas/s0-scenario.schema.json",
  "title": "Nexora VPE S0 Scenario",
  "description": "Versioned Learning Mode scenario contract for the single constrained S0 case. It is not a clinical protocol or assessment definition.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "mode",
    "pulse_revision",
    "patient",
    "pathology",
    "learning_objectives",
    "history",
    "clinical_hypotheses",
    "observations",
    "interventions",
    "escalations",
    "telemetry",
    "completion"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.2"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "mode": {"type": "string", "const": "learning"},
    "pulse_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "patient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["template"],
      "properties": {"template": {"type": "string", "const": "adult_male_standard"}}
    },
    "pathology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["existing_internal_hemorrhage"],
      "properties": {
        "existing_internal_hemorrhage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["compartment", "flow_rate_ml_min"],
          "properties": {
            "compartment": {"type": "string", "const": "Spleen"},
            "flow_rate_ml_min": {"type": "number", "exclusiveMinimum": 0}
          }
        }
      }
    },
    "learning_objectives": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^[a-z0-9_]{1,128}$"},
      "uniqueItems": true
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_intents"],
      "properties": {
        "allowed_intents": {
          "type": "array",
          "items": {"type": "string", "enum": ["PAIN_ONSET", "PAIN_LOCATION", "PAIN_RADIATION", "PAIN_SEVERITY", "ASSOCIATED_SYMPTOMS", "MECHANISM_OF_INJURY", "MEDICATIONS", "ALLERGIES", "PAST_MEDICAL_HISTORY", "ANTICOAGULANT_USE"]},
          "uniqueItems": true
        }
      }
    },
    "clinical_hypotheses": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed"],
      "properties": {
        "allowed": {
          "type": "array",
          "items": {"type": "string", "enum": ["INTERNAL_BLEEDING"]},
          "uniqueItems": true
        }
      }
    },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed"],
      "properties": {
        "allowed": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "enabled"],
            "properties": {
              "id": {"type": "string", "enum": ["FAST", "CBC"]},
              "enabled": {"type": "boolean"},
              "controlled_finding": {"type": "string", "minLength": 1, "maxLength": 128}
            },
            "allOf": [
              {"if": {"properties": {"enabled": {"const": true}}}, "then": {"required": ["controlled_finding"]}}
            ]
          }
        }
      }
    },
    "interventions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed"],
      "properties": {
        "allowed": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "pulse_compound", "volume_ml", "rate_ml_min"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9_]{1,128}$"},
              "pulse_compound": {"type": "string", "enum": ["Saline", "PackedRBC"]},
              "volume_ml": {"type": "number", "exclusiveMinimum": 0},
              "rate_ml_min": {"type": "number", "exclusiveMinimum": 0}
            }
          }
        }
      }
    },
    "escalations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed"],
      "properties": {
        "allowed": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id"],
            "properties": {"id": {"type": "string", "pattern": "^[a-z0-9_]{1,128}$"}}
          }
        }
      }
    },
    "telemetry": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "enum": ["heart_rate_bpm", "mean_arterial_pressure_mmhg", "blood_volume_ml", "total_hemorrhaged_volume_ml", "oxygen_saturation"]},
      "uniqueItems": true
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["success_rules", "failure_rules"],
      "properties": {
        "success_rules": {"type": "array", "maxItems": 0},
        "failure_rules": {"type": "array", "maxItems": 0}
      }
    }
  }
}

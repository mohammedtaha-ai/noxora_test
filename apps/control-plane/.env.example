APP_NAME=NexoraControlPlane
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=nexora_control_plane
DB_USERNAME=nexora_control
DB_PASSWORD=change-me-local-only
DB_SEARCH_PATH=control_plane,public

SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log

# Never set production credentials, APP_KEY, bearer tokens, or cloud secrets in this file.

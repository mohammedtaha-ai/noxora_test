# Local/test PostgreSQL only. Do not commit a real password or production URL.
DATABASE_URL=postgres://nexora_control:nexora_control_local_only@127.0.0.1:5432/nexora_control_plane_test?sslmode=disable

# Local/test ingress is intentionally loopback only.
PLATFORM_LISTEN_ADDR=127.0.0.1:8090
PLATFORM_LOG_LEVEL=info
PLATFORM_LEASE_DURATION=30s
PLATFORM_MAX_EVENT_BYTES=1048576

# Optional only when running from outside the repository tree.
# PLATFORM_REPOSITORY_ROOT=/absolute/path/to/noxora_test
